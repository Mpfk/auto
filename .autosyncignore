# .autosyncignore — paths the Auto sync must NEVER overwrite
#
# This file is the ownership contract: Auto owns framework files;
# consumers own everything listed here.
# See docs/auto/template-propagation.md for the full model.
#
# Syntax: gitignore patterns, relative to the repo root.
# Blank lines and lines starting with '#' are ignored.

# ---------------------------------------------------------------------------
# Consumer config (seeded once by Auto, then owned by the consumer)
# See: docs/auto/file-buckets.md — Config bucket
# ---------------------------------------------------------------------------
workflow.conf
.claude/settings.json
CLAUDE.md
README.md
.gitignore

# ---------------------------------------------------------------------------
# Consumer source and test code
# See: docs/auto/file-buckets.md — Consumer-owned bucket
# ---------------------------------------------------------------------------
src/
tests/

# ---------------------------------------------------------------------------
# Consumer-owned hook extensions (100+ range)
# Auto ships enforcement rules in the 000–099 range.
# Consumers add their own scripts in the 100+ range; those are never touched.
# See: docs/auto/hook-extension.md
# ---------------------------------------------------------------------------
.githooks/pre-commit.d/1[0-9][0-9]-*.sh
.githooks/commit-msg.d/1[0-9][0-9]-*.sh
.githooks/pre-push.d/1[0-9][0-9]-*.sh

# ---------------------------------------------------------------------------
# Consumer-added Claude commands
# Consumers may add new .md files under .claude/commands/; they do not edit
# Auto's shipped commands (those are framework-owned and always overwritten).
# Because the shipped commands are listed explicitly in .auto-framework-paths,
# any file NOT in that list is implicitly consumer-owned. This glob ensures
# the sync engine never touches any command file it did not ship itself.
# ---------------------------------------------------------------------------
.claude/commands/

# ---------------------------------------------------------------------------
# Consumer docs outside docs/auto/
# docs/auto/ is framework-owned and always synced.
# All other subdirectories under docs/ belong to the consumer.
# ---------------------------------------------------------------------------
docs/api/
docs/decisions/

# ---------------------------------------------------------------------------
# The ignore file itself
# Once seeded, the sync engine must not re-overwrite consumer additions.
# ---------------------------------------------------------------------------
.autosyncignore

# ---------------------------------------------------------------------------
# Version stamp (written by sync, not overwritten)
# ---------------------------------------------------------------------------
.auto-version
